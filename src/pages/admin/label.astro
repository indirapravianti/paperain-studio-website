---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="shipping label">
  <style is:global>
    /* Courier label: 100 × 150 mm, the standard thermal label size. Fields follow KiriminAja's
       shipping label doc plus the UAT checklist (sorting code, cities, item prices, order ref). */
    #label-sheet {
      width: 100mm;
      min-height: 150mm;
      box-sizing: border-box;
      border: 0.4mm solid #000;
      background: #fff;
      color: #000;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 7.5pt;
      line-height: 1.25;
      display: flex;
      flex-direction: column;
      margin: 0 auto;
    }
    #label-sheet .row { border-bottom: 0.3mm solid #000; display: flex; }
    #label-sheet .row:last-child { border-bottom: 0; }
    #label-sheet .cell { padding: 1mm 1.6mm; min-width: 0; }
    #label-sheet .cell + .cell { border-left: 0.3mm solid #000; }
    #label-sheet .cap { font-size: 6pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
    #label-sheet .big { font-size: 15pt; font-weight: 900; line-height: 1.05; }
    #label-sheet .bold { font-weight: 700; }
    #label-sheet .center { text-align: center; }
    #label-sheet .grow { flex: 1; }
    #label-sheet .items { width: 100%; border-collapse: collapse; font-size: 7pt; table-layout: fixed; }
    #label-sheet .items td:nth-child(2) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #label-sheet .items th { text-align: left; font-weight: 700; border-bottom: 0.2mm solid #000; padding: 0 0.6mm 0.4mm; }
    #label-sheet .items td { padding: 0.4mm 0.6mm; vertical-align: top; }
    #label-sheet .items .num { text-align: right; white-space: nowrap; }
    #label-sheet .disclaimer { font-size: 5.8pt; font-style: italic; }

    @media screen {
      #label-sheet { zoom: 1.5; }
    }

    @page { size: 100mm 150mm; margin: 0; }
    @media print {
      body * { visibility: hidden !important; }
      #label-sheet, #label-sheet * { visibility: visible !important; }
      #label-sheet { position: fixed; left: 0; top: 0; zoom: 1; height: 150mm; overflow: hidden; }
    }
  </style>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <div id="label-loading" class="text-center py-20">
      <p class="text-gray-400">loading...</p>
    </div>

    <div id="label-denied" class="hidden text-center py-20">
      <h1 class="text-2xl font-semibold mb-4">access denied</h1>
      <p class="text-gray-500 text-sm">you need admin access to view this page.</p>
    </div>

    <div id="label-main" class="hidden">
      <div class="no-print flex items-center justify-between mb-4 gap-3">
        <a href="/admin/orders" class="text-sm text-gray-500 hover:underline">&larr; back to orders</a>
        <div class="flex gap-2">
          <a id="pdf-link" href="#" target="_blank" class="hidden text-sm border border-gray-200 px-4 py-2 rounded-lg">KiriminAja PDF</a>
          <button id="print-btn" class="text-sm bg-primary text-white px-4 py-2 rounded-lg">print label</button>
        </div>
      </div>

      <p class="no-print text-xs text-gray-500 mb-6">
        Prints at 100 × 150 mm (standard courier label). On A4 paper, print at 100% / actual size and cut along the border.
        <span id="pdf-note" class="hidden">The KiriminAja PDF is the courier's own label for the same AWB.</span>
      </p>

      <div id="label-sheet">
        <!-- courier · service · shipping type -->
        <div class="row">
          <div class="cell center" style="width: 34mm; display: flex; align-items: center; justify-content: center;">
            <span class="big" id="lbl-courier">-</span>
          </div>
          <div class="cell center grow">
            <div class="cap">layanan</div>
            <div class="big" id="lbl-service-type">-</div>
            <div id="lbl-service">-</div>
          </div>
          <div class="cell center" style="width: 26mm; display: flex; flex-direction: column; justify-content: center;">
            <div class="cap">tipe</div>
            <div class="bold" style="font-size: 10pt;" id="lbl-shipping-type">NON-COD</div>
          </div>
        </div>

        <!-- sorting code · AWB -->
        <div class="row">
          <div class="cell center" style="width: 34mm;">
            <div class="cap">sorting code</div>
            <div class="bold" style="font-size: 12pt;" id="lbl-sorting">-</div>
          </div>
          <div class="cell grow" style="display: flex; flex-direction: column; justify-content: center;">
            <div class="cap">no. resi / AWB</div>
            <div class="bold" style="font-size: 10.5pt;" id="lbl-awb-top">-</div>
          </div>
        </div>

        <!-- AWB barcode -->
        <div class="row">
          <div class="cell grow center" style="padding-top: 1.6mm; padding-bottom: 1.2mm;">
            <svg id="lbl-barcode"></svg>
            <div class="bold" style="font-size: 9pt; margin-top: 0.8mm; letter-spacing: 0.04em;" id="lbl-awb">-</div>
          </div>
        </div>

        <!-- recipient · sender -->
        <div class="row">
          <div class="cell" style="width: 56%;">
            <div class="cap">penerima</div>
            <div class="bold" style="font-size: 9pt;" id="lbl-recipient-name">-</div>
            <div class="bold" id="lbl-recipient-phone">-</div>
            <div id="lbl-recipient-address">-</div>
          </div>
          <div class="cell grow">
            <div class="cap">pengirim</div>
            <div class="bold" style="font-size: 8.5pt;" id="lbl-sender-name">-</div>
            <div class="bold" id="lbl-sender-phone">-</div>
            <div id="lbl-sender-address">-</div>
          </div>
        </div>

        <!-- origin · destination -->
        <div class="row">
          <div class="cell center" style="width: 44%;">
            <div class="cap">kota asal</div>
            <div class="bold" style="font-size: 8.5pt; text-transform: uppercase;" id="lbl-origin">-</div>
          </div>
          <div class="cell center grow">
            <div class="cap">kota tujuan</div>
            <div class="bold" style="font-size: 8.5pt; text-transform: uppercase;" id="lbl-destination">-</div>
          </div>
        </div>

        <!-- payment note -->
        <div class="row">
          <div class="cell grow center">
            <span class="bold" id="lbl-payment-type">NON-COD</span>
            <span style="font-style: italic;" id="lbl-payment-note">· Penerima tidak perlu membayar apa pun ke kurir</span>
          </div>
        </div>

        <!-- weight · qty · insurance · date -->
        <div class="row">
          <div class="cell grow">
            <div class="cap">berat</div>
            <div class="bold" style="font-size: 9pt;" id="lbl-weight">-</div>
            <div style="font-size: 5.8pt;" id="lbl-weight-detail"></div>
          </div>
          <div class="cell" style="width: 14mm;">
            <div class="cap">qty</div>
            <div class="bold" style="font-size: 9pt;" id="lbl-qty">-</div>
          </div>
          <div class="cell" style="width: 22mm;">
            <div class="cap">asuransi</div>
            <div class="bold" id="lbl-insurance">-</div>
          </div>
          <div class="cell" style="width: 20mm;">
            <div class="cap">tgl. pesan</div>
            <div class="bold" id="lbl-date">-</div>
          </div>
        </div>

        <!-- order ref -->
        <div class="row">
          <div class="cell" style="width: 42%; display: flex; flex-direction: column; justify-content: center;">
            <div class="cap">no. pesanan</div>
            <div class="bold" style="font-size: 9pt;" id="lbl-order-ref">-</div>
          </div>
          <div class="cell grow center">
            <svg id="lbl-order-barcode"></svg>
          </div>
        </div>

        <!-- items -->
        <div class="row" style="flex: 1;">
          <div class="cell grow">
            <table class="items">
              <thead>
                <tr><th style="width: 4mm;">#</th><th>nama produk</th><th class="num" style="width: 8mm;">qty</th><th class="num" style="width: 16mm;">harga</th></tr>
              </thead>
              <tbody id="lbl-items"></tbody>
            </table>
            <div style="margin-top: 1mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><span class="bold">Catatan:</span> <span id="lbl-notes">-</span></div>
          </div>
        </div>

        <!-- KiriminAja standard notes -->
        <div class="row">
          <div class="cell grow disclaimer">
            * Pengirim wajib meminta bukti serah terima paket ke kurir.<br />
            * Jika paket ini retur, pengirim tetap dikenakan biaya keberangkatan dan biaya retur sesuai ekspedisi.
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script is:inline>
  (function() {
    const SUPABASE_URL = document.querySelector('meta[name="supabase-url"]')?.content;
    const SUPABASE_KEY = document.querySelector('meta[name="supabase-key"]')?.content;

    function getUser() { try { return JSON.parse(localStorage.getItem('sb-user')); } catch { return null; } }
    function getToken() { return localStorage.getItem('sb-access-token'); }

    const user = getUser();
    const token = getToken();
    const params = new URLSearchParams(window.location.search);
    const orderId = params.get('order');

    const loadingEl = document.getElementById('label-loading');
    const deniedEl = document.getElementById('label-denied');
    const mainEl = document.getElementById('label-main');

    // KiriminAja courier codes → the name printed in the logistic box.
    const COURIER_NAMES = {
      jne: 'JNE', jnt: 'J&T', sicepat: 'SICEPAT', anteraja: 'ANTERAJA', tiki: 'TIKI', idx: 'ID EXPRESS',
      ninja: 'NINJA', lion: 'LION PARCEL', sap: 'SAP', spx: 'SPX', posindonesia: 'POS', pos: 'POS',
      jntcargo: 'J&T CARGO', ncs: 'NCS', rpx: 'RPX', wahana: 'WAHANA', paxel: 'PAXEL',
    };
    // More rows than this push the label past 150 mm; the rest are summarised in one line.
    const MAX_ITEM_ROWS = 4;

    function set(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value == null || value === '' ? '-' : value;
    }

    function fmtIdr(n) {
      return 'Rp' + Math.round(Number(n) || 0).toLocaleString('id-ID');
    }

    function fmtDate(value) {
      if (!value) return '';
      const d = new Date(value);
      if (isNaN(d)) return '';
      const pad = (n) => String(n).padStart(2, '0');
      return pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear();
    }

    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, function(ch) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
      });
    }

    function drawBarcode(selector, value, heightMm) {
      if (!value || !window.JsBarcode) return;
      try {
        window.JsBarcode(selector, value, { format: 'CODE128A', displayValue: false, height: 48, margin: 0 });
      } catch {
        try {
          window.JsBarcode(selector, value, { format: 'CODE128', displayValue: false, height: 48, margin: 0 });
        } catch {}
      }
      fitBarcode(document.querySelector(selector), heightMm);
    }

    // JsBarcode draws a fixed 2px per bar, so a long AWB (e.g. sandbox MOCK-…) overflows the label.
    // Scale it to the cell width, never past its natural size, at a fixed printed height.
    function fitBarcode(svg, heightMm) {
      const width = parseFloat(svg?.getAttribute('width'));
      const height = parseFloat(svg?.getAttribute('height'));
      if (!width || !height) return;
      svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
      svg.setAttribute('preserveAspectRatio', 'none');
      svg.removeAttribute('width');
      svg.removeAttribute('height');
      svg.style.display = 'block';
      svg.style.margin = '0 auto';
      svg.style.width = '100%';
      svg.style.maxWidth = width + 'px';
      svg.style.height = heightMm + 'mm';
    }

    async function checkAdmin() {
      if (!user || !token || !SUPABASE_URL || !SUPABASE_KEY) return false;
      if (user.app_metadata?.role === 'admin' || user.user_metadata?.role === 'admin') return true;
      try {
        const res = await fetch(`${SUPABASE_URL}/auth/v1/user`, {
          headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + token },
        });
        const fresh = await res.json();
        return fresh.app_metadata?.role === 'admin';
      } catch { return false; }
    }

    checkAdmin().then(async (isAdmin) => {
      loadingEl.classList.add('hidden');
      if (!isAdmin || !orderId) { deniedEl.classList.remove('hidden'); return; }

      let payload;
      try {
        const res = await fetch('/api/kiriminaja-label?order_id=' + encodeURIComponent(orderId), {
          headers: { Authorization: 'Bearer ' + token },
        });
        payload = await res.json();
        if (!res.ok) throw new Error(payload.error || 'could not load label');
      } catch (err) {
        deniedEl.classList.remove('hidden');
        deniedEl.querySelector('p').textContent = err.message || 'could not load label';
        return;
      }

      const label = payload.label || {};
      mainEl.classList.remove('hidden');

      if (payload.pdf_url) {
        const link = document.getElementById('pdf-link');
        link.href = payload.pdf_url;
        link.classList.remove('hidden');
        document.getElementById('pdf-note').classList.remove('hidden');
      }

      const courierCode = String(label.courier || '').toLowerCase();
      set('lbl-courier', COURIER_NAMES[courierCode] || courierCode.toUpperCase());
      set('lbl-service-type', label.service_type);
      set('lbl-service', label.service_name);
      set('lbl-sorting', label.sorting_code || 'PENDING');
      set('lbl-awb-top', label.awb || '(belum terbit)');
      set('lbl-awb', label.awb);

      const baseType = label.shipping_type || 'NON-COD';
      const isCod = baseType === 'COD';
      const typeText = isCod && label.cod_amount ? 'COD: ' + fmtIdr(label.cod_amount) : baseType;
      set('lbl-shipping-type', baseType);
      set('lbl-payment-type', (label.cashless ? 'CASHLESS ' : '') + typeText);
      set('lbl-payment-note', isCod
        ? '· Kurir menagih nilai COD ke penerima'
        : '· Penerima tidak perlu membayar apa pun ke kurir');

      const sender = label.sender || {};
      const recipient = label.recipient || {};
      set('lbl-sender-name', sender.name);
      set('lbl-sender-phone', sender.phone);
      set('lbl-sender-address', sender.area);
      set('lbl-recipient-name', recipient.name);
      set('lbl-recipient-phone', recipient.phone);
      // Checkout addresses already end with the postal code; don't print it twice.
      const recipientAddress = String(recipient.address || '');
      set('lbl-recipient-address', recipient.zipcode && !recipientAddress.includes(recipient.zipcode)
        ? recipientAddress + ' ' + recipient.zipcode
        : recipientAddress);

      set('lbl-origin', label.origin_city);
      set('lbl-destination', [label.destination_city, label.destination_district].filter(Boolean).join(' · '));

      const actual = label.actual_weight_grams;
      const volume = label.volumetric_weight_grams;
      set('lbl-weight', label.weight_grams ? label.weight_grams + ' gr' : '');
      document.getElementById('lbl-weight-detail').textContent =
        actual && volume ? 'aktual ' + actual + ' gr · volume ' + volume + ' gr' : '';
      set('lbl-qty', label.qty ? label.qty + ' pcs' : '');
      set('lbl-insurance', label.insurance_amount > 0 ? fmtIdr(label.insurance_amount) : 'Tidak');
      set('lbl-date', fmtDate(label.order_date));
      set('lbl-order-ref', label.order_ref);
      set('lbl-notes', label.notes);

      const items = label.items || [];
      const shown = items.slice(0, MAX_ITEM_ROWS);
      let rows = shown.map(function(item, i) {
        return '<tr><td>' + (i + 1) + '</td><td>' + esc(item.name) + '</td><td class="num">' + esc(item.qty) +
          '</td><td class="num">' + esc(fmtIdr(item.price)) + '</td></tr>';
      }).join('');
      if (items.length > shown.length) {
        rows += '<tr><td></td><td colspan="3">+ ' + (items.length - shown.length) + ' produk lainnya</td></tr>';
      }
      document.getElementById('lbl-items').innerHTML = rows || '<tr><td colspan="4">-</td></tr>';

      drawBarcode('#lbl-barcode', label.awb, 14);
      drawBarcode('#lbl-order-barcode', label.order_ref, 8);
    });

    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  })();
</script>
