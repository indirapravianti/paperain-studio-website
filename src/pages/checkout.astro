---
import Layout from '../layouts/Layout.astro';
---

<Layout title="checkout">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <h1 class="text-2xl font-semibold mb-8">checkout</h1>

    <div class="grid md:grid-cols-5 gap-8">
      <div class="md:col-span-3">
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
          <p class="text-sm text-amber-900 leading-relaxed">
            <strong class="font-medium">shipping update:</strong> international air mail is still in progress.
            we are currently accepting orders within Indonesia only — we'll let you know when international shipping opens!
          </p>
        </div>

        <div id="intl-shipping-warning" class="hidden bg-red-50 border border-red-100 rounded-lg p-4 mb-6">
          <p class="text-sm text-red-700">
            sorry, we can only ship within Indonesia for now. please select Indonesia as your shipping country, or check back when international orders open.
          </p>
        </div>

        <div id="auth-notice" class="hidden bg-pastel-blue/20 border border-pastel-blue rounded-lg p-4 mb-6">
          <p class="text-sm text-burgundy">
            checking out as a guest.
            <a href="/auth/signin" class="market-aware-link text-primary hover:underline font-medium" data-href="/auth/signin">sign in</a>
            or
            <a href="/auth/signup" class="market-aware-link text-primary hover:underline font-medium" data-href="/auth/signup">create an account</a>
            to save your details and track orders.
          </p>
        </div>

        <form id="checkout-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium mb-1.5">full name</label>
            <input type="text" id="name" name="name" required
              class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-1.5">email address</label>
            <input type="email" id="email" name="email" required
              class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium mb-1.5">phone number</label>
            <input type="tel" id="phone" name="phone" required
              class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors" />
          </div>
          <!-- Country selection deactivated for now — Indonesia-only checkout. Re-enable this block
               (remove `hidden`) when international shipping is ready to launch. -->
          <div class="hidden">
            <label for="country" class="block text-sm font-medium mb-1.5">shipping country</label>
            <select id="country" required
              class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors bg-white">
              <option value="">select country</option>
              <option value="ID" selected>Indonesia</option>
              <option value="JP">Japan</option>
              <option value="SG">Singapore</option>
              <option value="MY">Malaysia</option>
              <option value="TH">Thailand</option>
              <option value="PH">Philippines</option>
              <option value="VN">Vietnam</option>
              <option value="KR">South Korea</option>
              <option value="TW">Taiwan</option>
              <option value="HK">Hong Kong</option>
              <option value="CN">China</option>
              <option value="IN">India</option>
              <option value="AU">Australia</option>
              <option value="NZ">New Zealand</option>
              <option value="US">United States</option>
              <option value="CA">Canada</option>
              <option value="GB">United Kingdom</option>
              <option value="DE">Germany</option>
              <option value="FR">France</option>
              <option value="NL">Netherlands</option>
              <option value="OTHER">Other</option>
            </select>
          </div>
          <div id="id-address-fields" class="space-y-5">
            <div>
              <label for="street" class="block text-sm font-medium mb-1.5">street address</label>
              <input type="text" id="street" name="street"
                class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors"
                placeholder="street, building, house number" />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="province" class="block text-sm font-medium mb-1.5">province</label>
                <select id="province"
                  class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors bg-white" disabled>
                  <option value="">loading...</option>
                </select>
              </div>
              <div>
                <label for="city" class="block text-sm font-medium mb-1.5">city / regency</label>
                <select id="city"
                  class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors bg-white" disabled>
                  <option value="">select province first</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="district" class="block text-sm font-medium mb-1.5">district</label>
                <select id="district"
                  class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors bg-white" disabled>
                  <option value="">select city first</option>
                </select>
              </div>
              <div>
                <label for="postal-code" class="block text-sm font-medium mb-1.5">postal code</label>
                <input type="text" id="postal-code" name="postal-code" inputmode="numeric" maxlength="5"
                  class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors" />
              </div>
            </div>

            <div id="courier-section" class="hidden">
              <label class="block text-sm font-medium mb-1.5">shipping courier</label>
              <div id="courier-list" class="space-y-2"></div>
              <p id="courier-status" class="text-xs text-gray-400 mt-1"></p>
            </div>
          </div>

          <div id="fallback-address-field" class="hidden">
            <label for="address" class="block text-sm font-medium mb-1.5">shipping address</label>
            <textarea id="address" name="address" rows="3"
              class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors resize-none"
              placeholder="street, city, state / province, postal code"></textarea>
          </div>
          <div>
            <label for="notes" class="block text-sm font-medium mb-1.5">order notes <span class="text-gray-400 font-normal">(optional)</span></label>
            <textarea id="notes" name="notes" rows="2"
              class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-primary transition-colors resize-none"
              placeholder="any special requests or notes"></textarea>
          </div>

          <div id="checkout-error" class="text-sm text-red-500 hidden"></div>

          <button type="submit" id="submit-btn"
            class="w-full bg-primary text-white py-3 rounded-lg hover:bg-primary/80 transition-colors text-sm font-medium mt-4">
            proceed to payment
          </button>
        </form>
      </div>

      <div class="md:col-span-2">
        <div class="bg-gray-50 rounded-xl p-6 sticky top-24">
          <h2 class="font-medium mb-4">order summary</h2>
          <div id="checkout-items" class="space-y-3 mb-4"></div>

          <div class="border-t border-gray-200 pt-4 space-y-2">
            <div id="checkout-discount-row" class="flex justify-between text-sm text-green-600 hidden">
              <span>discount (20%)</span>
              <span id="checkout-discount">-$0.00</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">shipping</span>
              <span id="checkout-shipping" class="text-gray-600">—</span>
            </div>
            <div class="flex justify-between font-medium border-t border-gray-200 pt-2">
              <span>total</span>
              <span id="checkout-total">$0.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function() {
    const SUPABASE_URL = document.querySelector('meta[name="supabase-url"]')?.content;
    const SUPABASE_KEY = document.querySelector('meta[name="supabase-key"]')?.content;

    function getUser() {
      try { return JSON.parse(localStorage.getItem('sb-user')); } catch { return null; }
    }
    function getToken() { return localStorage.getItem('sb-access-token'); }

    const cart = getCart();
    const container = document.getElementById('checkout-items');
    const totalEl = document.getElementById('checkout-total');
    const discountRow = document.getElementById('checkout-discount-row');
    const discountEl = document.getElementById('checkout-discount');
    const shippingEl = document.getElementById('checkout-shipping');
    const errorEl = document.getElementById('checkout-error');
    const user = getUser();
    var currency = typeof getCurrency === 'function' ? getCurrency() : 'IDR';
    var FLAT_SHIPPING_FEE = typeof getShippingFee === 'function' ? getShippingFee() : 48000;
    var SHIPPING_FEE = FLAT_SHIPPING_FEE;

    // Structured (KiriminAja) address + courier state
    var kiriminajaAvailable = true;
    var selectedRate = null;
    var provinceSelect = document.getElementById('province');
    var citySelect = document.getElementById('city');
    var districtSelect = document.getElementById('district');
    var postalInput = document.getElementById('postal-code');
    var courierSection = document.getElementById('courier-section');
    var courierList = document.getElementById('courier-list');
    var courierStatus = document.getElementById('courier-status');
    var idAddressFields = document.getElementById('id-address-fields');
    var fallbackAddressField = document.getElementById('fallback-address-field');

    if (!user) {
      document.getElementById('auth-notice').classList.remove('hidden');
    } else {
      prefillProfile();
    }

    async function prefillProfile() {
      if (!SUPABASE_URL || !SUPABASE_KEY || !user) return;
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/customers?id=eq.${user.id}&select=*`, {
          headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + getToken() },
        });
        const data = await res.json();
        if (data && data.length > 0) {
          const c = data[0];
          if (c.full_name) document.getElementById('name').value = c.full_name;
          if (c.email) document.getElementById('email').value = c.email;
          if (c.phone) document.getElementById('phone').value = c.phone;
          if (c.address) {
            document.getElementById('street').value = c.address;
            document.getElementById('address').value = c.address;
          }
        }
      } catch {}
    }

    async function fetchJson(url, opts) {
      var res = await fetch(url, opts);
      var text = await res.text();
      var json = {};
      try { json = text ? JSON.parse(text) : {}; } catch {}
      if (!res.ok) {
        var err = new Error(json.error || 'request failed');
        err.status = res.status;
        throw err;
      }
      return json;
    }

    function useFallbackAddress() {
      if (!kiriminajaAvailable) return;
      kiriminajaAvailable = false;
      idAddressFields.classList.add('hidden');
      fallbackAddressField.classList.remove('hidden');
      SHIPPING_FEE = FLAT_SHIPPING_FEE;
      updateTotals();
    }

    async function loadProvinces() {
      try {
        var json = await fetchJson('/api/kiriminaja-regions?type=province');
        var provinces = json.data || [];
        provinceSelect.innerHTML = '<option value="">select province</option>' +
          provinces.map(function(p) {
            return '<option value="' + p.id + '">' + p.provinsi_name + '</option>';
          }).join('');
        provinceSelect.disabled = false;
      } catch (err) {
        useFallbackAddress();
      }
    }

    async function loadCities(provinceId) {
      citySelect.innerHTML = '<option value="">loading...</option>';
      citySelect.disabled = true;
      districtSelect.innerHTML = '<option value="">select city first</option>';
      districtSelect.disabled = true;
      try {
        var json = await fetchJson('/api/kiriminaja-regions?type=city&province_id=' + encodeURIComponent(provinceId));
        var cities = json.data || [];
        citySelect.innerHTML = '<option value="">select city / regency</option>' +
          cities.map(function(c) {
            return '<option value="' + c.id + '">' + c.type + ' ' + c.kabupaten_name + '</option>';
          }).join('');
        citySelect.disabled = false;
      } catch (err) {
        if (err.status === 503) { useFallbackAddress(); return; }
        citySelect.innerHTML = '<option value="">could not load cities, try again</option>';
      }
    }

    async function loadDistricts(cityId) {
      districtSelect.innerHTML = '<option value="">loading...</option>';
      districtSelect.disabled = true;
      courierSection.classList.add('hidden');
      selectedRate = null;
      try {
        var json = await fetchJson('/api/kiriminaja-regions?type=district&city_id=' + encodeURIComponent(cityId));
        var districts = json.data || [];
        districtSelect.innerHTML = '<option value="">select district</option>' +
          districts.map(function(d) {
            return '<option value="' + d.id + '" data-postal="' + (d.postal_code || '') + '">' + d.kecamatan_name + '</option>';
          }).join('');
        districtSelect.disabled = false;
      } catch (err) {
        if (err.status === 503) { useFallbackAddress(); return; }
        districtSelect.innerHTML = '<option value="">could not load districts, try again</option>';
      }
    }

    async function loadCourierRates(districtId) {
      courierSection.classList.remove('hidden');
      courierList.innerHTML = '';
      courierStatus.textContent = 'checking courier rates...';
      selectedRate = null;
      SHIPPING_FEE = 0;
      updateTotals();

      try {
        var json = await fetchJson('/api/shipping-rate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: cartFiltered.map(function(item) { return { id: item.id, qty: item.qty }; }),
            district_id: districtId,
          }),
        });
        var rates = json.rates || [];
        if (rates.length === 0) {
          courierStatus.textContent = 'no courier available for this address yet.';
          return;
        }
        courierStatus.textContent = '';
        courierList.innerHTML = rates.map(function(r, idx) {
          return '<label class="courier-option flex items-center justify-between gap-3 border border-gray-200 rounded-lg px-4 py-2.5 text-sm cursor-pointer">' +
            '<span class="flex items-center gap-3">' +
              '<input type="radio" name="courier" class="courier-radio accent-primary" value="' + idx + '"' + (idx === 0 ? ' checked' : '') + ' />' +
              '<span><span class="font-medium">' + r.service_name + '</span>' +
                (r.etd ? '<br/><span class="text-xs text-gray-400">est. ' + r.etd + ' days</span>' : '') +
              '</span>' +
            '</span>' +
            '<span class="font-medium">' + fmt(r.cost) + '</span>' +
          '</label>';
        }).join('');

        function applySelection(idx) {
          selectedRate = rates[idx];
          SHIPPING_FEE = selectedRate.cost;
          updateTotals();
          document.querySelectorAll('.courier-option').forEach(function(el, i) {
            el.classList.toggle('border-primary', i === idx);
            el.classList.toggle('bg-primary/5', i === idx);
          });
        }

        courierList.querySelectorAll('.courier-radio').forEach(function(radio) {
          radio.addEventListener('change', function() { applySelection(Number(radio.value)); });
        });
        applySelection(0);
      } catch (err) {
        if (err.status === 503) { useFallbackAddress(); return; }
        courierStatus.textContent = 'could not load courier rates. please try again.';
      }
    }

    provinceSelect.addEventListener('change', function() {
      if (provinceSelect.value) loadCities(provinceSelect.value);
    });
    citySelect.addEventListener('change', function() {
      if (citySelect.value) loadDistricts(citySelect.value);
    });
    districtSelect.addEventListener('change', function() {
      var opt = districtSelect.selectedOptions[0];
      if (opt && opt.dataset.postal) postalInput.value = opt.dataset.postal;
      if (districtSelect.value) loadCourierRates(districtSelect.value);
    });

    loadProvinces();

    function fmt(val) {
      return typeof formatPrice === 'function' ? formatPrice(val) : 'Rp' + Math.round(Number(val)).toLocaleString('id-ID');
    }

    var cartFiltered = cart.filter(function(item) {
      return !item.currency || item.currency === currency;
    });

    if (cartFiltered.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400">your cart is empty.</p>';
      document.getElementById('submit-btn').disabled = true;
      document.getElementById('submit-btn').classList.add('opacity-50', 'cursor-not-allowed');
    } else {
      container.innerHTML = cartFiltered.map(item => {
        return `
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">${item.title} × ${item.qty}</span>
            <span>${fmt(item.price * item.qty)}</span>
          </div>`;
      }).join('');
    }

    function updateTotals() {
      var subtotal = cartFiltered.reduce(function(s, i) { return s + i.price * i.qty; }, 0);
      var volDisc = typeof getVolumeDiscount === 'function'
        ? getVolumeDiscount(subtotal)
        : (subtotal >= 80000 ? subtotal * 0.2 : 0);

      if (volDisc > 0) {
        discountRow.classList.remove('hidden');
        discountEl.textContent = '-' + fmt(volDisc);
      } else {
        discountRow.classList.add('hidden');
      }

      if (cartFiltered.length > 0) {
        shippingEl.textContent = fmt(SHIPPING_FEE);
        totalEl.textContent = fmt(subtotal - volDisc + SHIPPING_FEE);
      } else {
        shippingEl.textContent = '—';
        totalEl.textContent = fmt(0);
      }
    }

    updateTotals();

    var countrySelect = document.getElementById('country');
    var intlWarning = document.getElementById('intl-shipping-warning');

    function updateCountryWarning() {
      var isIndonesia = countrySelect.value === 'ID';
      intlWarning.classList.toggle('hidden', !countrySelect.value || isIndonesia);
    }

    countrySelect.addEventListener('change', updateCountryWarning);
    updateCountryWarning();

    document.getElementById('checkout-form').addEventListener('submit', function(e) {
      e.preventDefault();
      errorEl.classList.add('hidden');
      var btn = document.getElementById('submit-btn');
      btn.textContent = 'placing order...';
      btn.disabled = true;

      if (cartFiltered.length === 0) {
        errorEl.textContent = 'your cart is empty.';
        errorEl.classList.remove('hidden');
        btn.textContent = 'proceed to payment';
        btn.disabled = false;
        return;
      }

      var countryCode = document.getElementById('country').value;
      if (!countryCode) {
        errorEl.textContent = 'please select a shipping country.';
        errorEl.classList.remove('hidden');
        btn.textContent = 'proceed to payment';
        btn.disabled = false;
        return;
      }

      if (countryCode !== 'ID') {
        errorEl.textContent = 'we currently only ship within Indonesia. please select Indonesia or check back when international shipping opens.';
        errorEl.classList.remove('hidden');
        btn.textContent = 'proceed to payment';
        btn.disabled = false;
        return;
      }

      var shippingDetails = { name: document.getElementById('name').value, email: document.getElementById('email').value, phone: document.getElementById('phone').value, country: countryCode };

      if (kiriminajaAvailable) {
        var street = document.getElementById('street').value.trim();
        var provinceOpt = provinceSelect.selectedOptions[0];
        var cityOpt = citySelect.selectedOptions[0];
        var districtOpt = districtSelect.selectedOptions[0];
        var postal = postalInput.value.trim();

        if (!street || !provinceSelect.value || !citySelect.value || !districtSelect.value || !postal) {
          errorEl.textContent = 'please complete your shipping address (street, province, city, district, postal code).';
          errorEl.classList.remove('hidden');
          btn.textContent = 'proceed to payment';
          btn.disabled = false;
          return;
        }
        if (!selectedRate) {
          errorEl.textContent = 'please select a shipping courier.';
          errorEl.classList.remove('hidden');
          btn.textContent = 'proceed to payment';
          btn.disabled = false;
          return;
        }

        shippingDetails.address = street + ', ' + districtOpt.textContent + ', ' + cityOpt.textContent + ', ' + provinceOpt.textContent + ' ' + postal;
        shippingDetails.province = provinceOpt.textContent;
        shippingDetails.province_id = provinceSelect.value;
        shippingDetails.city = cityOpt.textContent;
        shippingDetails.city_id = citySelect.value;
        shippingDetails.district = districtOpt.textContent;
        shippingDetails.district_id = districtSelect.value;
        shippingDetails.postal_code = postal;
        shippingDetails.courier = selectedRate.courier;
        shippingDetails.service_type = selectedRate.service_type;
        shippingDetails.service_name = selectedRate.service_name;
      } else {
        var fallbackAddress = document.getElementById('address').value.trim();
        if (!fallbackAddress) {
          errorEl.textContent = 'please enter your shipping address.';
          errorEl.classList.remove('hidden');
          btn.textContent = 'proceed to payment';
          btn.disabled = false;
          return;
        }
        shippingDetails.address = fallbackAddress;
      }

      var subtotal = cartFiltered.reduce(function(s, i) { return s + i.price * i.qty; }, 0);
      var volDisc = typeof getVolumeDiscount === 'function'
        ? getVolumeDiscount(subtotal)
        : (subtotal >= 80000 ? subtotal * 0.2 : 0);
      var total = subtotal - volDisc + SHIPPING_FEE;
      var localOrderId = 'ORD-' + Date.now().toString(36).toUpperCase();

      try {
        sessionStorage.setItem('paperain-pending-payment', JSON.stringify({
          order: { id: localOrderId, display_id: localOrderId },
          items: cartFiltered.map(function(item) {
            return {
              id: item.id,
              title: item.title,
              qty: item.qty,
              price: item.price,
              image: item.image,
              category: item.category,
            };
          }),
          summary: {
            subtotal: subtotal,
            volumeDiscount: volDisc,
            shipping: SHIPPING_FEE,
            total: total,
          },
          shipping: shippingDetails,
          notes: document.getElementById('notes').value || null,
          currency: currency,
        }));
      } catch (storageErr) {
        errorEl.textContent = 'could not save order data. please try again.';
        errorEl.classList.remove('hidden');
        btn.textContent = 'proceed to payment';
        btn.disabled = false;
        return;
      }

      localStorage.setItem('paperain-cart', JSON.stringify(
        cart.filter(function(item) { return item.currency && item.currency !== currency; })
      ));
      updateCartCount();
      window.location.href = '/payment?id=' + localOrderId;
    });
  })();
</script>
