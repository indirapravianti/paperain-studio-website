# Google Analytics 4 — Measurement ID from analytics.google.com
PUBLIC_GA_ID=G-4X9TBCHVEV

PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Midtrans — use sandbox while testing (keys from dashboard.sandbox.midtrans.com)
PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
PUBLIC_MIDTRANS_ENV=sandbox
PUBLIC_SITE_URL=https://www.paperainstudio.com

# Server-side only (Vercel env vars; redeploy after changes):
# MIDTRANS_SERVER_KEY=your-midtrans-server-key

# Midtrans Dashboard → Settings → Configuration (use https://www.paperainstudio.com):
# Payment Notification URL: https://www.paperainstudio.com/api/midtrans-notification
# Finish Redirect URL:        https://www.paperainstudio.com/payment
# Unfinish Redirect URL:      https://www.paperainstudio.com/payment
# Error Redirect URL:         https://www.paperainstudio.com/payment

# Optional: run supabase/patch-007-run-all-pending.sql in Supabase SQL Editor
# (adds payment_token, midtrans_transaction_id, receipt_sent_at, etc.)

# KiriminAja — shipping coverage area + courier rates (https://developer.kiriminaja.com)
# Server-side only (Vercel env vars; redeploy after changes). Without these, checkout
# falls back to the flat SHIPPING_FEE_IDR rate and skips address/courier selection.
# KIRIMINAJA_TOKEN=your-kiriminaja-bearer-token
# KIRIMINAJA_BASE_URL=https://tdev.kiriminaja.com   # sandbox; swap for production URL from KiriminAja
# KIRIMINAJA_ORIGIN_DISTRICT_ID=0   # your warehouse's kecamatan id — look it up via /api/mitra/kecamatan
#
# Sender profile — required for shipment creation (request_pickup v6.2), not just pricing.
# Without these, orders still price/checkout fine but no AWB is ever created after payment.
# KIRIMINAJA_ORIGIN_NAME=paperain studio
# KIRIMINAJA_ORIGIN_PHONE=0895xxxxxxxxx
# KIRIMINAJA_ORIGIN_ADDRESS=full pickup address, min 20 characters
# KIRIMINAJA_ORIGIN_ZIPCODE=55283
# KIRIMINAJA_ORIGIN_KELURAHAN_ID=0   # your warehouse's kelurahan id — look it up via /api/mitra/kelurahan
# KIRIMINAJA_ORIGIN_LATITUDE=-7.758472
# KIRIMINAJA_ORIGIN_LONGITUDE=110.389833
#
# Run supabase/patch-009-kiriminaja-shipping.sql and supabase/patch-010-kiriminaja-shipment.sql
# once in Supabase SQL Editor (adds structured address/courier columns + AWB/tracking state to orders)
#
# When creating a KiriminAja API key, use:
#   Domain:      https://www.paperainstudio.com   (must match your live, DNS-resolvable domain)
#   Webhook URL: https://www.paperainstudio.com/api/kiriminaja-webhook

# Order confirmation emails (Resend — https://resend.com)
#
# REQUIRED in Vercel (Settings → Environment Variables → Production + Preview):
#   RESEND_API_KEY=re_xxxxxxxx          ← exact name; not "resend-vercel" or similar
#   SITE_URL=https://www.paperainstudio.com
#   FROM_EMAIL=orders@paperainstudio.com
#
# Optional:
#   FROM_NAME=paperain studio
#   REPLY_TO_EMAIL=paperainstudio@gmail.com
#
# Resend setup (before production):
#   1. Resend Dashboard → Domains → Add paperainstudio.com
#   2. Add DNS records (TXT, MX, DKIM) at your domain registrar
#   3. Wait until domain shows "Verified"
#   4. FROM_EMAIL must use that domain (e.g. orders@paperainstudio.com)
#
# Supabase setup (IMPORTANT — run once in SQL Editor):
#   supabase/patch-007-run-all-pending.sql
#   supabase/patch-008-inventory.sql
#
# Supabase Auth → URL configuration:
#   Site URL (production): https://www.paperainstudio.com
#   Redirect URLs — add ALL of these:
#     https://www.paperainstudio.com/auth/reset-password
#     https://www.paperainstudio.com/**
#     https://paperain-studio-website.vercel.app/auth/reset-password  (preview/testing)
#   Use www.paperainstudio.com as Site URL so password-reset emails link to your real domain.
#   Vercel preview URL is only for testing before DNS — add both to Redirect URLs.
#
# After adding/changing env vars in Vercel → Redeploy the project.
